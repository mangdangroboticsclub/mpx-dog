# Project sdkconfig defaults.
# Seeded so a fresh `idf.py reconfigure` / `fullclean` keeps these values.

# The HTTP server (network/http_server.cc) sets max_open_sockets = 12, which
# needs LWIP_MAX_SOCKETS >= 12 + 3 (internal) = 15. Default 10 caused
# "max_open_sockets is too large (max allowed 7)" and the server failed to
# start. 16 leaves a little headroom for the websocket chat + PWA serving.
CONFIG_LWIP_MAX_SOCKETS=16

# Socket recycling.  With frequent PWA polling (wifi/status, robot/status,
# marketplace), the default TIME_WAIT of 2*MSL = 2*60 s = 120 s made closed
# sockets linger for two minutes and exhaust the 16-socket pool ("Failed to
# create socket", accept errno 23).  Shorten MSL and enable SO_LINGER so the
# marketplace proxy can force an immediate close.
#
# 10 s was still not enough: LWIP_MAX_SOCKETS cannot go above 16 in ESP-IDF,
# and every connection the browser closes holds a slot for 2*MSL afterwards.
# At MSL=10 s that is a 20 s tail, so roughly one closed connection per second
# is enough to sit at 16/16 forever — which is exactly what the census in the
# log showed (12 of the 16 were port-80 sockets with no live peer).  5 s halves
# the tail.  Safe here: TIME_WAIT guards against delayed duplicate segments
# from a previous connection, and this is a LAN with sub-millisecond RTT, not
# an internet path where a packet can be queued for tens of seconds.
CONFIG_LWIP_TCP_MSL=5000
CONFIG_LWIP_SO_LINGER=y

# External PSRAM. Board is ESP32-S3-WROOM-1-N16R8 = 8 MB OCTAL PSRAM (see
# partitions.csv). It was disabled, so the WASM sandbox's 128 KB linear
# memory fell back to internal DRAM and every skill failed with
# "Failed to instantiate". Enabling octal PSRAM gives it 8 MB to work in.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# WPA2/WPA3-Enterprise (802.1X). Needed by network/wifi_sta.cc for school and
# campus networks, which authenticate with a username and password against a
# RADIUS server instead of a shared passphrase. It is on by default in the
# esp32s3 defaults, but it is the kind of option a `fullclean` can quietly
# drop, and the failure it produces then is a link error against
# esp_eap_client_* rather than anything that says "enterprise".
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
